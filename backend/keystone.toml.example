# Copy to backend/keystone.toml. Reference: docs/operations/configuration.md.
env = "development"
host = "127.0.0.1"
port = 8000
log_level = "INFO"

database_url = "postgresql+psycopg://keystone:keystone_local_only@127.0.0.1:55432/keystone"

session_hours = 72
pat_max_days = 90

# Audit logs are automatically pruned after 30 days by default.
# audit_cleanup_enabled = true
# audit_retention_days = 30

# Node-local work directory. Relative paths are based on this TOML.
file_coordination_root = "../.data/files"
file_default_storage = "local"
file_max_bytes = 16777216
file_min_free_bytes = 1073741824
file_upload_timeout_seconds = 3600

# Unreferenced active file cleanup (seconds, off by default). Check callers and references first.
# file_unreferenced_grace_seconds = 86400

# Optional model request limits.
# model_send_interval_ms = 0
# model_cooldown_seconds = 5
# model_cooldown_max_seconds = 300

# Generate a private Fernet key with `keystone init-credential-key`.
# credential_key = ""

# Optional OpenSandbox: docs/development/environment.md.
# opensandbox_url = "http://127.0.0.1:8090"
# opensandbox_key = "opensandbox_local_only"
# browser_runtime_image = "keystone-browser-chromium:local"

# Optional first-run admin password; keystone init otherwise prompts.
# initial_admin_password = ""

[file_storages.local]
driver = "filesystem"
root = "../.data/files"

# Optional S3 source. Set real credentials only in private keystone.toml or via env.
# Set file_default_storage = "cloud" above to use S3 by default.
# [file_storages.cloud]
# driver = "s3"
# endpoint = "https://s3.example.com"
# bucket = "keystone-files"
# region = "us-east-1"
# prefix = "documents"
# access_key = ""
# secret_key = ""
