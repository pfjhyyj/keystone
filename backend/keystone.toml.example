# Copy to keystone.toml and start API/Worker/CLI from backend/.
# KEYSTONE_* environment variables override individual fields. Restart after changes.
env = "development"
host = "127.0.0.1"
port = 8000
log_level = "INFO"

# Local development database; keep in sync with deploy/.env if overriding it.
database_url = "postgresql+psycopg://keystone:keystone_local_only@127.0.0.1:55432/keystone"
browser_origins = [
    "http://127.0.0.1:5173",
    "http://localhost:5173",
    "http://127.0.0.1:8080",
    "http://localhost:8080",
]
session_hours = 8
pat_max_days = 90

# Paths are relative to this configuration file, including environment overrides.
file_coordination_root = "../.data/files"
file_default_storage = "local"
# Default remains 16 MiB; local media deployments may set 17179869184 (16 GiB).
# Match the file route's Nginx limit. S3 keeps its existing 64 MiB limit in 0A.
file_max_bytes = 16777216
file_transfer_slots = 4
# Shared API/Worker scratch budget: each slot gets an equal share (here 16 GiB).
file_temp_bytes = 68719476736
# Per-filesystem free-space floor, shared by API and all Workers (1 GiB).
file_min_free_bytes = 1073741824
file_upload_timeout_seconds = 3600

# No identity inventory is required. Start extra Workers with distinct fixed identities.
# The default worker_id is "keystone-worker"; override KEYSTONE_WORKER_ID per extra process.
# Concurrency and shutdown use built-in defaults. Optional tuning: docs/configuration.md.

# Optional shared model send controls (all API/Workers must agree).
# model_send_interval_ms = 0
# model_cooldown_seconds = 5
# model_cooldown_max_seconds = 300

# Model channels/keys are configured manually in the console after startup.

# Optional for non-interactive initialization of an empty installation only.
# Otherwise `keystone init` prompts. Existing passwords are never reset.
# initial_admin_password = ""

[file_storages.local]
driver = "filesystem"
root = "../.data/files"
# For simultaneous local + S3 sources see docs/configuration.md.
