# Local development only. Copy to backend/.env and start API/Worker/CLI from backend/.
# Process variables take priority. Restart API/Worker after changes.
# Retained backend settings; details: docs/configuration.md.

# Runtime
KEYSTONE_ENV=development
KEYSTONE_HOST=127.0.0.1
KEYSTONE_PORT=8000
# DEBUG, INFO, WARNING or ERROR.
KEYSTONE_LOG_LEVEL=INFO

# Database (local development password only; keep in sync with deploy/.env).
# Use the host-mapped port here; Compose backend services use postgres:5432 instead.
KEYSTONE_DATABASE_URL=postgresql+psycopg://keystone:keystone_local_only@127.0.0.1:55432/keystone

# Exact browser origins (no path or trailing slash; production requires HTTPS).
KEYSTONE_BROWSER_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8080","http://localhost:8080"]'
# Session lifetime in hours; maximum personal access token lifetime in days.
KEYSTONE_SESSION_HOURS=8
KEYSTONE_PAT_MAX_DAYS=90

# File sources and the independent shared coordination directory.
# Paths are relative to the backend working directory. Sources must be explicit.
KEYSTONE_FILE_COORDINATION_ROOT=../.data/files
KEYSTONE_FILE_STORAGES='{"local":{"driver":"filesystem","root":"../.data/files"}}'
KEYSTONE_FILE_DEFAULT_STORAGE=local
# See docs/configuration.md for simultaneous local + S3 sources.
# Upload bytes: default 16 MiB, maximum 64 MiB; coordinate Nginx's upload limit.
KEYSTONE_FILE_MAX_BYTES=16777216

# Optional Worker health file (disabled by default); parent directory must exist.
# Uncomment for Worker and --check; use a different file for each local Worker.
# KEYSTONE_WORKER_READY_FILE=../.data/keystone-worker.ready

# Models and Flow
# disabled by default; mock for development/test; live currently supports OpenRouter only.
KEYSTONE_MODEL_MODE=disabled
KEYSTONE_FLOW_ENABLED=false
# Mock uses fake secrets; live uses separate inference/Management Key references.
# Never commit real secrets. See README for setup.
KEYSTONE_MODEL_SECRETS='{}'
