# Local development only. Copy to frontend/console/.env and run pnpm dev from that directory.
# Process variables take priority. Restart Vite after changes.

# Development proxy (used by Vite only, never exposed to browser code).
# Browser requests keep the same-origin /api path; production uses Nginx instead.
KEYSTONE_API_PROXY=http://127.0.0.1:8000

# No browser VITE_* settings are required. Keep backend secrets out of this file.
