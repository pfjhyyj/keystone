# Optional overrides for development dependencies only.
# Defaults work with backend/keystone.toml.example; no env file is needed for the default start.
# To customize: cp deploy/.env.example deploy/.env, then pass --env-file deploy/.env.
# Keep the backend database URL in sync when changing these values.
POSTGRES_PASSWORD=keystone_local_only
KEYSTONE_POSTGRES_PORT=55432
