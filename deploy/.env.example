# Local development only. Copy to deploy/.env. Do not use this password in production.
# Pass with docker compose --env-file deploy/.env -f deploy/compose.yaml ...
# Existing shell variables override this file. Recreate services after changes.
# All Compose inputs; details: docs/configuration.md.

# Database (keep the password and URL credentials in sync; URL-encode special characters).
POSTGRES_PASSWORD=keystone_local_only
KEYSTONE_DATABASE_URL=postgresql+psycopg://keystone:keystone_local_only@postgres:5432/keystone

# Backend runtime (shared by API, Worker and one-off CLI services).
# Container listeners, coordination directory and Worker health file are fixed in compose.yaml.
KEYSTONE_ENV=development
# DEBUG, INFO, WARNING or ERROR.
KEYSTONE_LOG_LEVEL=INFO

# Exact browser origins
# Keep origins in sync with the public admin URL; production requires HTTPS origins.
KEYSTONE_BROWSER_ORIGINS='["http://127.0.0.1:8080","http://localhost:8080"]'
# Session lifetime in hours; maximum personal access token lifetime in days.
KEYSTONE_SESSION_HOURS=8
KEYSTONE_PAT_MAX_DAYS=90

# Upload bytes: default 16 MiB, maximum 64 MiB; update Nginx above 16 MiB.
KEYSTONE_FILE_MAX_BYTES=16777216
# Explicit named sources. See docs/configuration.md for local + S3.
KEYSTONE_FILE_STORAGES='{"local":{"driver":"filesystem","root":"/data/files"}}'
KEYSTONE_FILE_DEFAULT_STORAGE=local
# Add the cloud source in JSON; the coordination directory stays /data/files.

# Models and Flow
# Flow is enabled by default; model sending still requires an explicit mode change.
KEYSTONE_MODEL_MODE=disabled
KEYSTONE_FLOW_ENABLED=true
# mock: development/test + fake secrets. live: OpenRouter only, see README before enabling.
# Keep inference and Management Key references separate; never commit actual secrets.
# Keep JSON single-quoted to preserve literal dollar signs.
KEYSTONE_MODEL_SECRETS='{}'

# Host ports (container ports remain PostgreSQL 5432, API 8000 and admin 80).
# Separate recovery projects use different host ports and the original image IDs/digests.
KEYSTONE_POSTGRES_PORT=55432
KEYSTONE_API_PORT=8000
KEYSTONE_ADMIN_PORT=8080

# Image tags for builds/releases; use original IDs or digests when restoring backups.
KEYSTONE_BACKEND_IMAGE=keystone-backend:local
KEYSTONE_ADMIN_IMAGE=keystone-admin:local
KEYSTONE_POSTGRES_IMAGE=postgres:17.11-alpine
