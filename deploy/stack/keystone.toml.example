# Copy to deploy/stack/keystone.toml. Reference: docs/operations/configuration.md.
# Set the Fernet key for channel credentials in the private TOML.
# credential_key = ""
# Public HTTPS origin of the console.
browser_origins = ["https://keystone.example.com"]

file_coordination_root = "/data/files"
file_default_storage = "local"

[file_storages.local]
driver = "filesystem"
root = "/data/files"
