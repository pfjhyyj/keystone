# Copy to deploy/stack/keystone.toml; mounted read-only into init, API and Worker.
# Compose sets env, database_url, host and port; secrets stay in deploy/stack/.env.
# Exact HTTPS origins of the reverse proxy in front of the console port.
browser_origins = ["https://keystone.example.com"]

file_coordination_root = "/data/files"
file_default_storage = "local"

[file_storages.local]
driver = "filesystem"
root = "/data/files"
# Other parameters and S3 sources: docs/operations/configuration.md.
