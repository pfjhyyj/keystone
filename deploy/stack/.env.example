# Copy to deploy/stack/.env; docker compose reads it from this directory.
# Use fixed tags or digests built per docs/operations/deployment.md.
KEYSTONE_BACKEND_IMAGE=
KEYSTONE_CONSOLE_IMAGE=
# URL-safe characters only; it is also embedded in the backend database URL.
POSTGRES_PASSWORD=
# Only for `docker compose run --rm init keystone init --non-interactive` on an empty installation.
# KEYSTONE_INITIAL_ADMIN_PASSWORD=

# Optional overrides.
# KEYSTONE_CONFIG_PATH=./keystone.toml
# KEYSTONE_HOST_ID=keystone-host
# KEYSTONE_WORKER_ID=keystone-worker
# KEYSTONE_WORKER_STOP_GRACE=60s
# KEYSTONE_CONSOLE_BIND=127.0.0.1
# KEYSTONE_CONSOLE_PORT=8080
# KEYSTONE_POSTGRES_IMAGE=postgres:17.11-alpine
